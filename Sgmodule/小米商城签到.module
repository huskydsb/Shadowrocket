#!name=小米商城签到任务
#!desc=自动获取小米商城 serviceToken / sign / actId，并执行每日任务签到。首次需打开小米商城 App 以完成参数抓取。
#!openUrl=https://m.mi.com
#!arguments=启用参数获取:true, 签到任务时间:15 9 * * *, 启用签到任务:true
#!arguments-desc=\n★ 参数说明:\n\n - 启用参数获取: 是否启用拦截获取小米商城 serviceToken / sign / actId（默认开启）\n\n - 签到任务时间: Cron 表达式（默认每天 09:15）\n\n - 启用签到任务: 是否启用小米商城每日任务（默认开启）\n\n\n★ 使用提示:\n\n - 首次使用需打开【小米商城 App】并进入任意活动页\n - 若提示 sign 失效，重新打开 App 即可自动更新\n - Cron 示例：每天 09:15 → `15 9 * * *`

[Script]

# ===== 获取小米商城参数 =====
小米商城获取参数 = type=http-request, pattern=^https:\/\/shop-api\.retail\.mi\.com\/mtop\/.*, requires-body=true, script-path=https://raw.githubusercontent.com/huskydsb/Shadowrocket/main/Scripts/xiaomishopcookie.js, enable={{{启用参数获取}}}, timeout=30

# ===== 小米商城签到任务 =====
小米商城签到 = type=cron, script-path=https://raw.githubusercontent.com/huskydsb/Shadowrocket/main/Scripts/xiaomishopsign.js, cronexpr={{{签到任务时间}}}, timeout=120, enable={{{启用签到任务}}}

[MITM]
hostname = %APPEND% shop-api.retail.mi.com
